# Copy this file to ".env" and fill in the values (see README > Setup).
# Never commit ".env". If you add a variable, also add it to "src/env.js".

# Any long random string
AUTH_SECRET=""

# Local PostgreSQL: put in your own password.
# Or ask the team for the shared Supabase URL and paste it here instead.
DATABASE_URL="postgresql://postgres:password@localhost:5432/rjb-hotel-t3"

# Your own Xendit account in Test mode
XENDIT_SECRET_KEY=""
XENDIT_CALLBACK_TOKEN=""

# Where Xendit sends the guest back after paying
APP_URL="http://localhost:3000"
